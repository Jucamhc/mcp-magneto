{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfil-maestro.local/perfil-maestro.schema.json",
  "title": "Perfil maestro",
  "description": "Fuente única de verdad del candidato, compartida por todos los MCP de portales de empleo. Versión 1 del estándar.",
  "type": "object",
  "required": ["version", "datos_personales"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "actualizado": { "$ref": "#/$defs/fecha_dia" },
    "fuentes": { "type": "array", "items": { "type": "string" }, "description": "De dónde salieron los datos (CV en PDF, LinkedIn, portal…)." },
    "datos_personales": {
      "type": "object",
      "required": ["nombre"],
      "properties": {
        "nombre": { "type": "string", "minLength": 1 },
        "ciudad": { "type": "string" },
        "pais": { "type": "string" },
        "zona_horaria": { "type": "string", "examples": ["UTC-5"] },
        "telefono": { "type": "string" },
        "whatsapp": { "type": "string" },
        "correo": { "type": "string" },
        "linkedin": { "$ref": "#/$defs/url_o_vacio" },
        "github": { "$ref": "#/$defs/url_o_vacio" },
        "portafolio": { "$ref": "#/$defs/url_o_vacio" },
        "foto": { "type": "string", "description": "Ruta relativa a la carpeta del perfil maestro, o absoluta." }
      }
    },
    "titular": { "$ref": "#/$defs/texto_multi" },
    "resumen": { "$ref": "#/$defs/texto_multi" },
    "profesion": { "type": "string", "description": "Profesión principal (p. ej. el título universitario)." },
    "experiencia": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["empresa", "cargo", "inicio"],
        "properties": {
          "empresa": { "type": "string" },
          "descripcion_empresa": { "type": "string" },
          "cargo": { "type": "string" },
          "cargo_oficial": { "type": "string", "description": "Cargo en el contrato, si difiere del cargo real." },
          "cargo_en": { "type": "string" },
          "tipo_contrato": { "type": "string" },
          "inicio": { "$ref": "#/$defs/fecha" },
          "fin": { "anyOf": [{ "$ref": "#/$defs/fecha" }, { "type": "null" }], "description": "null = empleo actual." },
          "modalidad": { "type": "string", "examples": ["Remoto", "Presencial", "Híbrido"] },
          "ubicacion": { "type": "string" },
          "logros_es": { "type": "array", "items": { "type": "string" } },
          "logros_en": { "type": "array", "items": { "type": "string" } },
          "tecnologias": { "type": "array", "items": { "type": "string" } },
          "portales": { "$ref": "#/$defs/portales" }
        }
      }
    },
    "formacion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["institucion", "titulo_es"],
        "properties": {
          "institucion": { "type": "string" },
          "titulo_es": { "type": "string" },
          "titulo_en": { "type": "string" },
          "nivel": { "type": "string", "examples": ["Universitaria", "Tecnológica", "Técnico Laboral", "Especialización", "Maestría", "Doctorado"] },
          "inicio": { "$ref": "#/$defs/fecha" },
          "fin": { "anyOf": [{ "$ref": "#/$defs/fecha" }, { "type": "null" }] },
          "graduado": { "type": "boolean" },
          "mostrar_en_cv": { "type": "boolean", "description": "false = el usuario no quiere mostrarla." },
          "ciudad": { "type": "string" },
          "portales": { "$ref": "#/$defs/portales" }
        }
      }
    },
    "certificaciones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nombre"],
        "properties": {
          "nombre": { "type": "string" },
          "emisor": { "type": "string" },
          "fecha": { "$ref": "#/$defs/fecha" },
          "url": { "type": "string" },
          "portales": { "$ref": "#/$defs/portales" }
        }
      }
    },
    "apps_publicadas": { "type": "array", "items": { "type": "object" } },
    "aptitudes": {
      "type": "object",
      "description": "Grupos libres de aptitudes (frontend, backend, datos, …).",
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "habilidades_clave": {
      "type": "object",
      "properties": {
        "tecnicas": { "type": "array", "items": { "type": "string", "maxLength": 40 } },
        "blandas": { "type": "array", "items": { "type": "string", "maxLength": 40 } }
      }
    },
    "anios_experiencia": { "type": "object" },
    "idiomas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["idioma", "nivel"],
        "properties": {
          "idioma": { "type": "string" },
          "nivel": { "type": "string", "examples": ["Nativo", "Básico", "Intermedio", "Avanzado"] },
          "nota": { "type": "string" }
        }
      }
    },
    "preferencias": {
      "type": "object",
      "properties": {
        "modalidad": { "type": "string", "examples": ["Solo remoto", "Remoto o híbrido", "Cualquiera"] },
        "acepta_reubicacion": { "type": "boolean" },
        "puede_viajar": { "type": "boolean" },
        "paises": { "type": "array", "items": { "type": "string" } },
        "salario_minimo_laboral_cop": { "type": ["number", "null"] },
        "salario_minimo_prestacion_cop": { "type": ["number", "null"] },
        "tipos_contrato": { "type": "array", "items": { "type": "string" } },
        "disponibilidad": { "type": "string" },
        "acepta_prueba_tecnica": { "type": "boolean" }
      }
    },
    "seguridad_social": {
      "type": "object",
      "description": "Solo con datos que dio el usuario; nunca supuestos.",
      "properties": {
        "pension_obligatoria": { "type": ["string", "null"] },
        "cesantias": { "type": ["string", "null"] },
        "pension_voluntaria": { "type": ["string", "null"] },
        "eps": { "type": ["string", "null"] },
        "caja_compensacion": { "type": ["string", "null"] }
      }
    },
    "cv_pdf": {
      "description": "Ruta del CV en PDF, o un objeto { version: ruta } si hay varias.",
      "anyOf": [{ "type": "string" }, { "type": "object", "additionalProperties": { "type": "string" } }]
    },
    "respuestas_frecuentes": { "type": "object", "additionalProperties": { "type": "string" } },
    "portales": { "$ref": "#/$defs/portales" },
    "pendientes_de_confirmar": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "fecha": { "type": "string", "pattern": "^\\d{4}(-\\d{2})?$", "description": "AAAA o AAAA-MM." },
    "fecha_dia": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "url_o_vacio": { "type": "string", "pattern": "^(https?://.*)?$" },
    "texto_multi": {
      "type": "object",
      "description": "Texto por idioma: es, en…",
      "additionalProperties": { "type": "string" }
    },
    "portales": {
      "type": "object",
      "description": "Datos propios de cada portal, bajo su id (elempleo, computrabajo, infojobs…). Un MCP solo lee y escribe su propia clave.",
      "additionalProperties": { "type": "object" }
    }
  }
}
